+    private ArrayList<TLRPC.Dialog> withLocalPins(ArrayList<TLRPC.Dialog> dialogs) {
+        final LinkedHashSet<Long> pins = getLocalPinnedDialogs();
+        if (pins.isEmpty() || dialogs.isEmpty()) {
+            return dialogs;
+        }
+        int endOfSyncedPins = 0;
+        while (endOfSyncedPins < dialogs.size()) {
+            final TLRPC.Dialog dialog = dialogs.get(endOfSyncedPins);
+            if (!dialog.pinned && !(dialog instanceof TLRPC.TL_dialogFolder)
+                    && !getMessagesController().isPromoDialog(dialog.id, false)) {
+                break;
+            }
+            endOfSyncedPins++;
+        }
+        final HashMap<Long, TLRPC.Dialog> local = new HashMap<>();
+        for (int i = endOfSyncedPins; i < dialogs.size(); i++) {
+            final TLRPC.Dialog dialog = dialogs.get(i);
+            if (!dialog.pinned && pins.contains(dialog.id)) {
+                local.put(dialog.id, dialog);
+            }
+        }
+        if (local.isEmpty()) {
+            return dialogs;
+        }
+        final ArrayList<TLRPC.Dialog> sorted = new ArrayList<>(dialogs.size());
+        sorted.addAll(dialogs.subList(0, endOfSyncedPins));
+        final ArrayList<Long> localOrder = new ArrayList<>(pins);
+        for (int i = localOrder.size() - 1; i >= 0; i--) {
+            final TLRPC.Dialog dialog = local.get(localOrder.get(i));
+            if (dialog != null) {
+                sorted.add(dialog);
+            }
+        }
+        for (int i = endOfSyncedPins; i < dialogs.size(); i++) {
+            final TLRPC.Dialog dialog = dialogs.get(i);
+            if (!local.containsKey(dialog.id)) {
+                sorted.add(dialog);
+            }
+        }
+        return sorted;
+    }
